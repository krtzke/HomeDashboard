# Copy to /etc/caddy/Caddyfile and replace the address with your Pi's fixed IP
# (and optionally a hostname your router resolves, e.g. "https://dashboard.lan").
https://192.168.178.50 {
	# Certificate from Caddy's own local CA — install its root cert on each device (see README).
	tls internal
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
